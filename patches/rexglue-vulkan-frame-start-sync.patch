+  // A non-frame submission may still be recording at the start of a frame.
+  // Close it before choosing a fence, or a sync wait would miss it.
+  const bool sync_at_frame_start = is_opening_frame && REXCVAR_GET(vulkan_sync_at_frame_start);
+  const bool sync_at_submission = REXCVAR_GET(vulkan_sync_at_submission);
+  if ((sync_at_frame_start || sync_at_submission) && submission_open_ &&
+      !EndSubmission(false)) {
+    return false;
+  }
+
   // Check the fence - needed for all kinds of submissions (to reclaim transient
   // resources early) and specifically for frames (not to queue too many), and
   // await the availability of the current frame. Also check whether the device
   // is still available, and whether the await was successful.
   uint64_t await_submission =
       is_opening_frame ? closed_frame_submissions_[frame_current_ % kMaxFramesInFlight] : 0;
+  if (sync_at_submission) {
+    await_submission = std::max(await_submission, GetCurrentSubmission() - 1);
+  }
+  if (sync_at_frame_start) {
+    const uint64_t newest_submitted = GetCurrentSubmission() - 1;
+    const uint64_t keep_submissions =
+        std::min<uint64_t>(REXCVAR_GET(vulkan_sync_at_frame_start_frames), kMaxFramesInFlight);
+    const uint64_t sync_submission =
+        newest_submitted > keep_submissions ? newest_submitted - keep_submissions : 0;
+    await_submission = std::max(await_submission, sync_submission);
+  }
+  const bool blocking_for_sync = (sync_at_frame_start || sync_at_submission) &&
+                                 await_submission > submission_completed_;
+  const uint64_t wait_start_us = blocking_for_sync ? CounterNowMicros() : 0;
   CheckSubmissionFenceAndDeviceLoss(await_submission);
+  if (blocking_for_sync) {
+    static uint64_t last_report_us = 0;
+    static uint64_t waits = 0;
+    static uint64_t total_wait_us = 0;
+    ++waits;
+    total_wait_us += CounterNowMicros() - wait_start_us;
+    const uint64_t now_us = CounterNowMicros();
+    if (now_us - last_report_us >= UINT64_C(2000000)) {
+      REXGPU_INFO("Vulkan {} sync: target {}, keep up to {} submissions; "
+                  "{} waits, {} us total in interval",
+                  sync_at_submission ? "submission" : "frame-start",
+                  await_submission,
+                  sync_at_submission ? 0
+                                     : std::min<uint32_t>(REXCVAR_GET(vulkan_sync_at_frame_start_frames),
+                                                          kMaxFramesInFlight),
+                  waits, total_wait_us);
+      last_report_us = now_us;
+      waits = 0;
+      total_wait_us = 0;
+    }
+  }
   if (device_lost_ || submission_completed_ < await_submission) {
