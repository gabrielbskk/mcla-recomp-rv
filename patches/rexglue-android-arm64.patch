+
+void WindowSDL::HideAutoHiddenCursorNow() {
+  // SDL only blanks the cursor over the client area (WM_SETCURSOR with
+  // HTCLIENT on Windows), so the title bar, the borders and other windows keep
+  // theirs.
+  if (GetCursorVisibility() != CursorVisibility::kAutoHidden || !IsAutoHiddenCursorShown() ||
+      !HasFocus() || IsCursorAutoHideVetoed()) {
+    return;
+  }
+  if (cursor_hide_timer_) {
+    SDL_RemoveTimer(cursor_hide_timer_);
+    cursor_hide_timer_ = 0;
+  }
+  SetAutoHiddenCursorShown(false);
+  SDL_HideCursor();
+}
+
+// SDL timer thread: defers the hide to the UI thread. The window owns the timer
+// and removes it before destroying the SDL window; the alive token covers a
+// call already queued by then.
+Uint32 SDLCALL WindowSDL::CursorAutoHideTimerCallback(void* userdata, SDL_TimerID timer_id,
+                                                      Uint32 interval) {
+  (void)interval;
+  auto* window = static_cast<WindowSDL*>(userdata);
+  std::weak_ptr<bool> alive = window->GetAliveToken();
+  window->app_context().CallInUIThreadDeferred([window, alive, timer_id] {
+    // Mouse input since re-armed the timer; this expiry is stale.
+    if (alive.expired() || window->cursor_hide_timer_ != timer_id) {
+      return;
+    }
+    window->cursor_hide_timer_ = 0;
+    window->HideAutoHiddenCursorNow();
+  });
+  return 0;  // One-shot.
+}
