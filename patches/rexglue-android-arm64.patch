+    bool back_buffer = true;
+    Microsoft::WRL::ComPtr<ID3D12Resource> real;
+    Microsoft::WRL::ComPtr<ID3D12Resource> generated;
+    Microsoft::WRL::ComPtr<ID3D12Resource> overlay;
