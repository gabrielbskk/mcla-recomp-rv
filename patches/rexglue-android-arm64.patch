+                                               6550,  2300,  15635, 16450};
+      std::memcpy(metadata.RedPrimary, kPrimaries, sizeof(kPrimaries));
+      metadata.MaxMasteringLuminance = UINT(levels.max_nits + 0.5f);
+      metadata.MinMasteringLuminance = UINT(levels.min_nits * 10000.0f + 0.5f);
+      metadata.MaxContentLightLevel = UINT16(levels.max_nits + 0.5f);
+      metadata.MaxFrameAverageLightLevel = UINT16(levels.max_frame_average_nits + 0.5f);
+      swap_chain_4->SetHDRMetaData(DXGI_HDR_METADATA_TYPE_HDR10, sizeof(metadata), &metadata);
+    }
