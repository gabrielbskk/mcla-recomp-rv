+// Whether FidelityFX's Vulkan runtime is there (next to the executable, or
+// linked in).
+static bool TaaRuntimeThere() {
+#if !(defined(REX_HAS_FSR) && REX_HAS_FSR)
+  return false;
+#elif defined(REX_FSR_STATIC) && REX_FSR_STATIC
+  return FsrRuntime::Linked();
+#else
+#if REX_PLATFORM_WIN32
+  const char* name = "amd_fidelityfx_vk.dll";
+#else
+  const char* name = "libamd_fidelityfx_vk.so";
+#endif
+  // Loaded (and kept), not only looked for: a library whose imports fail (the Visual C++
+  // runtime missing) is there and unusable.
+  std::string error;
+  switch (rex::platform::CheckLoadable(rex::filesystem::GetExecutableFolder() / name, &error)) {
+    case rex::platform::LibraryCheck::kLoads:
+      return true;
+    case rex::platform::LibraryCheck::kFailed:
+      REXGPU_WARN("Temporal AA: {} is there but doesn't load ({})", name, error);
+      return false;
+    default:
+      return false;
+  }
+#endif
+}
