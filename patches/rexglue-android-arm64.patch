+    dont_unroll for (uint i = 0u; i < 4u; ++i) {
+      packed = uint4_xe(
+          packed.yzw,
+          XeResolveDirectLoad32bppSample(
+              resolve_info, source_info,
+              edram_sample + uint2_xe(i * pixel_stride_samples, 0u)));
+    }
+    return packed;
