+void Presenter::UpdateFrameGenerationStatus() {
+  FrameGenerationStatus status;
+  if (!frame_generation_supported_) {
+    status.state = FrameGenerationState::kUnavailable;
+    status.why = FrameGenerationUnsupportedReason();
+  } else if (frame_generation_unavailable_.load(std::memory_order_acquire)) {
+    status.state = FrameGenerationState::kUnavailable;
+    status.why = "FAILED";
+  } else {
+    status.state = FrameGenerationState::kAvailable;
