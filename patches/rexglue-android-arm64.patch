+bool D3D12Provider::QueryVideoMemory(uint64_t& local_usage_out, uint64_t& local_budget_out,
+                                     uint64_t& non_local_usage_out,
+                                     uint64_t& non_local_budget_out) const {
+  if (!dxgi_adapter3_) {
+    return false;
+  }
+  DXGI_QUERY_VIDEO_MEMORY_INFO local = {};
+  if (FAILED(dxgi_adapter3_->QueryVideoMemoryInfo(0, DXGI_MEMORY_SEGMENT_GROUP_LOCAL, &local))) {
+    return false;
+  }
+  DXGI_QUERY_VIDEO_MEMORY_INFO non_local = {};
+  if (FAILED(dxgi_adapter3_->QueryVideoMemoryInfo(0, DXGI_MEMORY_SEGMENT_GROUP_NON_LOCAL,
+                                                  &non_local))) {
+    non_local = {};
+  }
+  local_usage_out = local.CurrentUsage;
+  local_budget_out = local.Budget;
+  non_local_usage_out = non_local.CurrentUsage;
+  non_local_budget_out = non_local.Budget;
+  return true;
+}
