+ID3D12Resource* D3D12CommandProcessor::HdrGetTexture(HdrTexture texture) {
+  Microsoft::WRL::ComPtr<ID3D12Resource>& resource = hdr_textures_[texture];
+  if (resource && (resource->GetDesc().Width != hdr_output_width_ ||
+                   resource->GetDesc().Height != hdr_output_height_)) {
+    resource->AddRef();
+    resources_for_deletion_.emplace_back(GetCurrentSubmission(), resource.Get());
+    resource.Reset();
+  }
+  if (!resource && hdr_output_width_ && hdr_output_height_) {
+    ID3D12Device* device = GetD3D12Provider().GetDevice();
+    D3D12_RESOURCE_DESC desc = {};
+    desc.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+    desc.Width = hdr_output_width_;
+    desc.Height = hdr_output_height_;
+    desc.DepthOrArraySize = 1;
+    desc.MipLevels = 1;
+    desc.Format = texture == kHdrTextureScene ? DXGI_FORMAT_R16G16B16A16_FLOAT
+                                              : DXGI_FORMAT_R8G8B8A8_UNORM;
+    desc.SampleDesc.Count = 1;
+    bool is_ui_layer = texture == kHdrTextureUiLayer;
+    desc.Flags = is_ui_layer                    ? D3D12_RESOURCE_FLAG_ALLOW_RENDER_TARGET
+                 : texture == kHdrTextureScene ? D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS
+                                               : D3D12_RESOURCE_FLAG_NONE;
+    if (FAILED(device->CreateCommittedResource(&ui::d3d12::util::kHeapPropertiesDefault,
+                                               GetD3D12Provider().GetHeapFlagCreateNotZeroed(),
+                                               &desc, kHdrTextureState, nullptr,
+                                               IID_PPV_ARGS(&resource)))) {
+      return nullptr;
+    }
+    if (is_ui_layer) {
+      if (!hdr_ui_layer_rtv_heap_) {
+        D3D12_DESCRIPTOR_HEAP_DESC heap_desc = {D3D12_DESCRIPTOR_HEAP_TYPE_RTV, 1,
+                                                D3D12_DESCRIPTOR_HEAP_FLAG_NONE, 0};
+        device->CreateDescriptorHeap(&heap_desc, IID_PPV_ARGS(&hdr_ui_layer_rtv_heap_));
+      }
+      if (hdr_ui_layer_rtv_heap_) {
+        device->CreateRenderTargetView(resource.Get(), nullptr,
+                                       hdr_ui_layer_rtv_heap_->GetCPUDescriptorHandleForHeapStart());
+      }
+    }
+  }
+  return resource.Get();
+}
+
+void D3D12CommandProcessor::HdrWriteTextureSRV(HdrTexture texture,
+                                               D3D12_CPU_DESCRIPTOR_HANDLE handle) {
+  D3D12_SHADER_RESOURCE_VIEW_DESC srv_desc = {};
+  srv_desc.Format = texture == kHdrTextureScene ? DXGI_FORMAT_R16G16B16A16_FLOAT
+                                                : DXGI_FORMAT_R8G8B8A8_UNORM;
+  srv_desc.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2D;
+  srv_desc.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
+  srv_desc.Texture2D.MipLevels = 1;
+  GetD3D12Provider().GetDevice()->CreateShaderResourceView(hdr_textures_[texture].Get(),
+                                                           &srv_desc, handle);
+}
+
+bool D3D12CommandProcessor::HdrRenderScene(const D3D12Shader& vertex_shader,
+                                           const D3D12Shader& pixel_shader) {
+  ID3D12Resource* scene = HdrGetTexture(kHdrTextureScene);
+  if (!scene || !hdr_scene_pipeline_) {
+    return false;
+  }
+  const D3D12Shader::TextureBinding* bindings[4] = {};
+  for (uint32_t i = 0; i < 4; ++i) {
+    for (const D3D12Shader::TextureBinding& binding :
+         (i < 3 ? pixel_shader : vertex_shader).GetTextureBindingsAfterTranslation()) {
+      if (binding.fetch_constant == kHdrSceneFetchConstants[i]) {
+        bindings[i] = &binding;
+      }
+    }
+    if (!bindings[i]) {
+      return false;
+    }
+  }
+  // Bindful: the textures' views and the output's; bindless: the output's.
+  ui::d3d12::util::DescriptorCpuGpuHandlePair descriptors[5];
+  uint32_t one_use_count = bindless_resources_used_ ? 1 : 5;
+  if (!RequestOneUseSingleViewDescriptors(one_use_count, descriptors)) {
+    return false;
+  }
+  const ui::d3d12::D3D12Provider& provider = GetD3D12Provider();
+  D3D12_GPU_DESCRIPTOR_HANDLE tables[5];
+  for (uint32_t i = 0; i < 4; ++i) {
+    if (bindless_resources_used_) {
+      tables[i] = provider.OffsetViewDescriptor(
+          view_bindless_heap_gpu_start_,
+          texture_cache_->GetActiveTextureBindlessSRVIndex(*bindings[i]));
+    } else {
+      texture_cache_->WriteActiveTextureBindfulSRV(*bindings[i], descriptors[1 + i].first);
+      tables[i] = descriptors[1 + i].second;
+    }
+  }
+  D3D12_UNORDERED_ACCESS_VIEW_DESC uav_desc = {};
+  uav_desc.Format = DXGI_FORMAT_R16G16B16A16_FLOAT;
+  uav_desc.ViewDimension = D3D12_UAV_DIMENSION_TEXTURE2D;
+  provider.GetDevice()->CreateUnorderedAccessView(scene, nullptr, &uav_desc,
+                                                  descriptors[0].first);
+  tables[4] = descriptors[0].second;
+  PushTransitionBarrier(scene, kHdrTextureState, D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+  SubmitBarriers();
+  deferred_command_list_.D3DSetComputeRootSignature(hdr_scene_root_signature_.Get());
+  SetExternalPipeline(hdr_scene_pipeline_.Get());
+  deferred_command_list_.D3DSetComputeRoot32BitConstants(
+      0, sizeof(HdrSceneConstants) / sizeof(uint32_t), &hdr_scene_constants_, 0);
+  for (uint32_t i = 0; i < 5; ++i) {
+    deferred_command_list_.D3DSetComputeRootDescriptorTable(1 + i, tables[i]);
+  }
+  deferred_command_list_.D3DDispatch((hdr_output_width_ + 15) / 16, (hdr_output_height_ + 7) / 8,
+                                     1);
+  PushTransitionBarrier(scene, D3D12_RESOURCE_STATE_UNORDERED_ACCESS, kHdrTextureState);
+  SubmitBarriers();
+  return true;
+}
