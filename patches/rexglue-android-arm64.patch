+void VulkanPresenter::PaintContext::DestroyHdrUiLayer() {
+  const VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  util::DestroyAndNullHandle(dfn.vkDestroyFramebuffer, device, hdr_ui_layer_framebuffer);
+  util::DestroyAndNullHandle(dfn.vkDestroyImageView, device, hdr_ui_layer_view);
+  util::DestroyAndNullHandle(dfn.vkDestroyImage, device, hdr_ui_layer_image);
+  util::DestroyAndNullHandle(dfn.vkFreeMemory, device, hdr_ui_layer_memory);
+}
