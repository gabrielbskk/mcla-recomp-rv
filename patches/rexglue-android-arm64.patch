+    for (const TextureHeap& other : texture_heaps_) {
+      empty_heaps += (other.heap && !other.used) ? 1 : 0;
+    }
+    if (empty_heaps > 1) {
+      heap.heap.Reset();
+      heap.free_ranges.clear();
