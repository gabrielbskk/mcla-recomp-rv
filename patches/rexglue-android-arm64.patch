+ReadbackResolveMode CommandProcessor::GetReadbackResolveModeFor(
+    bool legacy_readback_resolve_enabled, uint32_t written_address, uint32_t written_length) {
+  ReadbackResolveMode mode = GetReadbackResolveMode(legacy_readback_resolve_enabled);
+
+  const std::string& rules_text = REXCVAR_GET(readback_resolve_rules);
+  if (rules_text != readback_rules_text_) {
+    readback_rules_text_ = rules_text;
+    ParseReadbackRules(readback_rules_text_, readback_rules_, "readback_resolve_rules");
+    REXGPU_INFO("readback_resolve_rules: {} rule(s) from \"{}\"", readback_rules_.size(),
+                readback_rules_text_);
+  }
+  const int32_t log_request = REXCVAR_GET(resolve_log_frames);
+  if (log_request > 0) {
+    resolve_log_by_frames_ = guest_marker_frame_ != 0;
+    resolve_log_until_ =
+        (resolve_log_by_frames_ ? guest_marker_frame_ : counter_) + uint32_t(log_request);
+    resolve_log_count_ = 0;
+    REXCVAR_SET(resolve_log_frames, 0);
+    REXGPU_INFO("resolve log: the next {} {} (from {} to {})", log_request,
+                resolve_log_by_frames_ ? "title frames" : "swap commands (no frame markers)",
+                resolve_log_by_frames_ ? guest_marker_frame_ : counter_, resolve_log_until_);
+  }
+  const bool log_new = REXCVAR_GET(resolve_log_new);
+  if (log_new != resolve_log_new_was_on_) {
+    resolve_log_new_was_on_ = log_new;
+    resolve_log_seen_.clear();
+    if (log_new) {
+      resolve_log_count_ = 0;
+    }
+    REXGPU_INFO("resolve log: {} the first occurrence of each distinct resolve",
+                log_new ? "logging" : "no longer logging");
+  }
+  const bool logging_window = ResolveLogWindowOpen();
+  if (readback_rules_.empty() && !logging_window && !log_new) {
+    return mode;
+  }
+
+  const reg::RB_COPY_CONTROL copy_control = register_file_->Get<reg::RB_COPY_CONTROL>();
+  const reg::RB_COPY_DEST_INFO copy_dest_info = register_file_->Get<reg::RB_COPY_DEST_INFO>();
+  const reg::RB_COPY_DEST_PITCH copy_dest_pitch = register_file_->Get<reg::RB_COPY_DEST_PITCH>();
+  const uint64_t first = written_address;
+  const uint64_t last = first + (written_length ? written_length - 1 : 0);
+  const int matched = FindMatchingReadbackRule(
+      readback_rules_, first, last, written_length, uint32_t(copy_dest_pitch.copy_dest_pitch),
+      uint32_t(copy_dest_pitch.copy_dest_height), uint32_t(copy_dest_info.copy_dest_format),
+      uint32_t(copy_control.copy_src_select), guest_marker_phase_);
+  if (matched >= 0) {
+    mode = readback_rules_[size_t(matched)].mode;
+  }
+  bool logging = logging_window;
+  const char* log_tag = "";
+  if (log_new) {
+    // FNV-1a over what tells one resolve from another.
+    uint64_t signature = 1469598103934665603ull;
+    const uint64_t parts[] = {written_address,
+                              written_length,
+                              uint64_t(copy_dest_pitch.copy_dest_pitch),
+                              uint64_t(copy_dest_pitch.copy_dest_height),
+                              uint64_t(copy_dest_info.copy_dest_format),
+                              uint64_t(copy_control.copy_src_select),
+                              guest_marker_phase_};
+    for (const uint64_t part : parts) {
+      signature = (signature ^ part) * 1099511628211ull;
+    }
+    if (resolve_log_seen_.size() < 200000 && resolve_log_seen_.insert(signature).second) {
+      logging = true;
+      log_tag = " [new]";
+    }
+  }
+  if (logging) {
+    static const char* const kModeNames[] = {"off", "fast", "some", "full"};
+    REXGPU_INFO(
+        "resolve {}: swap {} guest frame {} phase 0x{:X} address 0x{:08X} length {} pitch {} "
+        "height {} format {} source {} -> {}{}{}",
+        resolve_log_count_++, counter_, guest_marker_frame_, guest_marker_phase_, written_address,
+        written_length, uint32_t(copy_dest_pitch.copy_dest_pitch),
+        uint32_t(copy_dest_pitch.copy_dest_height), uint32_t(copy_dest_info.copy_dest_format),
+        uint32_t(copy_control.copy_src_select), kModeNames[uint32_t(mode)],
+        matched >= 0 ? fmt::format(" (rule {}: {})", matched,
+                                   readback_rules_[size_t(matched)].text)
+                     : std::string(),
+        log_tag);
+  }
+  return mode;
+}
