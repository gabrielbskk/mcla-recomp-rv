+    statement.first = i;
+    statement.value_col = std::min(line.find_first_not_of(" \t", pos + 1), line.size());
+    const TomlPos end = SkipTomlValue(lines, {i, statement.value_col});
+    statement.last = end.line;
+    statement.value_end = end.col;
+    statements.push_back(statement);
+    i = end.line + 1;
+  }
+  return statements;
+}
+
+bool HexDigits(std::string_view text, size_t at, size_t count, uint32_t& value) {
+  if (at + count > text.size()) {
+    return false;
+  }
+  value = 0;
+  for (size_t i = at; i < at + count; ++i) {
+    const char c = text[i];
+    if (!std::isxdigit(static_cast<unsigned char>(c))) {
+      return false;
+    }
+    value = value * 16 + uint32_t(std::isdigit(static_cast<unsigned char>(c))
+                                      ? c - '0'
+                                      : (std::tolower(static_cast<unsigned char>(c)) - 'a' + 10));
+  }
+  return true;
+}
+
+// Whether a basic string's body has only TOML escapes, including \u and \U
+// of a Unicode scalar value.
+bool ValidTomlEscapes(std::string_view body) {
+  for (size_t i = 0; i < body.size(); ++i) {
+    if (body[i] != '\\') {
+      continue;
+    }
+    const char next = i + 1 < body.size() ? body[i + 1] : '\0';
+    uint32_t code = 0;
+    if (next != '\0' && std::strchr("btnfr\"\\", next)) {
+      ++i;
+    } else if ((next == 'u' && HexDigits(body, i + 2, 4, code)) ||
+               (next == 'U' && HexDigits(body, i + 2, 8, code))) {
+      if (code > 0x10FFFF || (code >= 0xD800 && code <= 0xDFFF)) {
+        return false;
+      }
+      i += next == 'u' ? 5 : 9;
+    } else {
+      return false;
+    }
+  }
+  return true;
+}
+
+// A one-line double-quoted value whose backslashes are not TOML escapes, as
+// older saves wrote Windows paths, as the same text in a literal string; empty
+// when it isn't one (or holds a quote, which a literal string can't).
+std::string LiteralForBrokenString(const std::string& line, size_t value_col) {
+  if (value_col >= line.size() || line[value_col] != '"' ||
+      line.compare(value_col, 3, "\"\"\"") == 0) {
+    return {};
+  }
+  const size_t close = line.rfind('"');
+  if (close <= value_col) {
+    return {};
+  }
+  const std::string body = line.substr(value_col + 1, close - value_col - 1);
+  const std::string tail = TrimToml(line.substr(close + 1));
+  if (body.find_first_of("\"'") != std::string::npos || (!tail.empty() && tail[0] != '#') ||
+      ValidTomlEscapes(body)) {
+    return {};
+  }
+  return line.substr(0, value_col) + "'" + body + "'" + line.substr(close + 1);
+}
+
+std::string TablePrefix(std::string table) {
+  table.erase(std::remove(table.begin(), table.end(), '"'), table.end());
+  std::replace(table.begin(), table.end(), '.', '_');
+  return table;
+}
+
+// A file toml++ rejects is read again statement by statement, so that one bad
+// line no longer costs every setting in it: each statement that parses on its
+// own applies (with its [table] prefix), a double-quoted value that fails only
+// for its backslashes is taken as written, and the rest is skipped with a
+// warning.
+void LoadConfigByLine(const std::filesystem::path& config_path) {
+  std::ifstream in(config_path, std::ios::binary);
+  std::stringstream content;
+  content << in.rdbuf();
+  const TomlText text = SplitToml(content.str());
+  std::vector<size_t> unknown;
+  const auto statements = ScanToml(text.lines, nullptr, &unknown);
+  int skipped = 0;
+  auto skip = [&](size_t line) {
+    REXLOG_WARN("Config: {} line {} skipped: {}", config_path.filename().string(), line + 1,
+                text.lines[line]);
+    ++skipped;
+  };
+  for (size_t line : unknown) {
+    skip(line);
+  }
+  for (const TomlStatement& statement : statements) {
+    if (statement.table == "\x01") {
+      skip(statement.first);
+      continue;
+    }
+    std::string snippet;
+    for (size_t i = statement.first; i <= statement.last; ++i) {
+      snippet += text.lines[i] + "\n";
+    }
+    std::optional<toml::table> parsed;
+    try {
+      parsed = toml::parse(snippet);
+    } catch (const toml::parse_error&) {
+      if (statement.first == statement.last) {
+        const std::string literal =
+            LiteralForBrokenString(text.lines[statement.first], statement.value_col);
+        if (!literal.empty()) {
+          try {
+            parsed = toml::parse(literal);
+          } catch (const toml::parse_error&) {
+          }
+        }
+      }
+    }
+    if (!parsed) {
+      skip(statement.first);
+      continue;
+    }
+    ApplyTomlTable(*parsed, TablePrefix(statement.table));
+  }
+  REXLOG_WARN("Config: {} read statement by statement, {} line(s) skipped", config_path.string(),
+              skipped);
+}
+
+int CurrentProcessId() {
+#if defined(_WIN32)
+  return _getpid();
+#else
+  return int(getpid());
+#endif
+}
+
+// Written beside the file, flushed to the disk, then renamed over it, so
+// that a crash or a full disk can't leave half a file.
+bool WriteFileDurably(const std::filesystem::path& path, const std::string& content) {
+  auto temporary = path;
+  temporary += "." + std::to_string(CurrentProcessId()) + ".tmp";
+#if defined(_WIN32)
+  FILE* file = _wfopen(temporary.c_str(), L"wb");
+#else
+  FILE* file = std::fopen(temporary.c_str(), "wb");
+#endif
+  if (!file) {
+    return false;
+  }
+  bool ok = std::fwrite(content.data(), 1, content.size(), file) == content.size();
+  ok = std::fflush(file) == 0 && ok;
+#if defined(_WIN32)
+  ok = _commit(_fileno(file)) == 0 && ok;
+#else
+  ok = fsync(fileno(file)) == 0 && ok;
+#endif
+  ok = std::fclose(file) == 0 && ok;
+  std::error_code error;
+  if (ok) {
+    std::filesystem::rename(temporary, path, error);
+    ok = !error;
+  }
+  if (!ok) {
+    std::filesystem::remove(temporary, error);
+  }
+  return ok;
+}
+
+// Sets these `key = value` statements (values already in TOML form) in the
+// file: each replaced where it is, keeping a comment after it, or added
+// before the first [table]; every other line kept. False, with the file as
+// it was, when it can't be read or written.
+bool MergeIntoToml(const std::filesystem::path& path,
+                   const std::vector<std::pair<std::string, std::string>>& values) {
+  std::string old_text;
+  std::error_code error;
+  if (std::filesystem::exists(path, error)) {
+    std::ifstream in(path, std::ios::binary);
+    std::stringstream content;
+    if (in) {
+      content << in.rdbuf();  // (sets failbit on `content` for an empty file)
+    }
+    if (!in || in.bad()) {
+      REXLOG_ERROR("Config: could not read {}; not changed", path.string());
+      return false;
+    }
+    old_text = content.str();
+  } else if (error) {
+    REXLOG_ERROR("Config: could not check {}: {}", path.string(), error.message());
+    return false;
+  }
+  TomlText text = SplitToml(old_text);
+  if (text.lines.empty()) {
+    text.lines.push_back("# Settings");
+  }
+  std::vector<bool> written(values.size(), false);
+  const auto statements = ScanToml(text.lines, nullptr, nullptr);
+  // From the last statement up, so that the line numbers of those above hold.
+  for (auto it = statements.rbegin(); it != statements.rend(); ++it) {
+    bool own = false;
+    for (size_t k = 0; k < values.size() && it->table.empty(); ++k) {
+      if (it->key != values[k].first) {
+        continue;
+      }
+      const std::string& last = text.lines[it->last];
+      const std::string after = last.substr(std::min(it->value_end, last.size()));
+      text.lines[it->first] = text.lines[it->first].substr(0, it->value_col) + values[k].second + after;
+      text.lines.erase(text.lines.begin() + std::ptrdiff_t(it->first + 1),
+                       text.lines.begin() + std::ptrdiff_t(it->last + 1));
+      written[k] = own = true;
+      break;
+    }
+    if (!own && it->first == it->last) {
+      std::string literal = LiteralForBrokenString(text.lines[it->first], it->value_col);
+      if (!literal.empty()) {
+        text.lines[it->first] = std::move(literal);
+      }
+    }
+  }
+  size_t first_table = 0;
+  ScanToml(text.lines, &first_table, nullptr);
+  std::vector<std::string> added;
+  for (size_t k = 0; k < values.size(); ++k) {
+    if (!written[k]) {
+      added.push_back(values[k].first + " = " + values[k].second);
+    }
+  }
+  text.lines.insert(text.lines.begin() + std::ptrdiff_t(first_table), added.begin(), added.end());
+  if (!WriteFileDurably(path, JoinToml(text))) {
+    REXLOG_ERROR("Config: could not write {}; not changed", path.string());
+    return false;
+  }
+  return true;
+}
