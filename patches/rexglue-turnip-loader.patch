+#if REX_PLATFORM_ANDROID
+static void* OpenSelectedAndroidDriver() {
+  const std::filesystem::path driver_dir = rex::filesystem::GetUserFolder() / "gpu-drivers";
+  if (!std::filesystem::exists(driver_dir / "selected.txt")) {
+    return nullptr;
+  }
+  const std::filesystem::path driver = driver_dir / "libvulkan_freedreno.so";
+  if (!std::filesystem::is_regular_file(driver)) {
+    REXLOG_WARN("Selected Turnip driver is missing; using system Vulkan");
+    return nullptr;
+  }
+  Dl_info self_info{};
+  if (!dladdr(reinterpret_cast<void*>(&OpenSelectedAndroidDriver), &self_info) ||
+      !self_info.dli_fname) {
+    REXLOG_WARN("Cannot locate Android Vulkan hook libraries; using system Vulkan");
+    return nullptr;
+  }
+  const std::filesystem::path hook_dir = std::filesystem::path(self_info.dli_fname).parent_path();
+  void* tools_lib = dlopen("libadrenotools.so", RTLD_NOW | RTLD_LOCAL);
+  if (!tools_lib) {
+    REXLOG_WARN("Cannot load AdrenoTools: {}; using system Vulkan", dlerror());
+    return nullptr;
+  }
+  using OpenFn = void* (*)(int, int, const char*, const char*, const char*, const char*,
+                            const char*, void**);
+  auto open = reinterpret_cast<OpenFn>(dlsym(tools_lib, "adrenotools_open_libvulkan"));
+  if (!open) {
+    REXLOG_WARN("AdrenoTools Vulkan entry point missing; using system Vulkan");
+    return nullptr;
+  }
+  constexpr int kCustomDriver = 1;
+  const std::string hook_path = hook_dir.string();
+  const std::string driver_path = driver_dir.string() + "/";
+  void* handle = open(RTLD_NOW, kCustomDriver, nullptr, hook_path.c_str(),
+                      driver_path.c_str(), "libvulkan_freedreno.so", nullptr, nullptr);
+  if (handle) {
+    REXLOG_INFO("AdrenoTools opened Vulkan for selected Turnip from {}; verify GPU name", driver.string());
+  } else {
+    REXLOG_WARN("AdrenoTools rejected selected driver; using system Vulkan");
+  }
+  return handle;
+}
+#endif
