--- a/src/ui/CMakeLists.txt
+++ b/src/ui/CMakeLists.txt
@@ -144,6 +144,14 @@
     target_compile_definitions(rexui PRIVATE REX_HAS_FIDELITYFX_SDK=1)
 endif()
 
+# The same filters on Android: their shaders are in the tree and need none of
+# FidelityFX's source or runtime. The temporal upscaler (present_effect = fsr2
+# or fsr3) does need the runtime, which only the builds that load it have, so
+# it is not offered there.
+if(ANDROID)
+    target_compile_definitions(rexui PRIVATE REX_HAS_FIDELITYFX_SDK=1)
+endif()
+
 # Frame generation on D3D12 (rexglue-frame-generation.patch): the ffx-api
 # headers (MIT); the runtime is loaded at run time from the executable's folder.
 if(REXGLUE_ENABLE_FSR AND WIN32 AND REXGLUE_USE_D3D12)
--- a/src/ui/presenter.cpp
+++ b/src/ui/presenter.cpp
@@ -52,10 +52,20 @@
     .range(0, 100);
 
 #if defined(REX_HAS_FIDELITYFX_SDK)
+#if defined(REX_HAS_FIDELITYFX_RUNTIME) && REX_HAS_FIDELITYFX_RUNTIME
+// The temporal upscaler (fsr2, fsr3) needs FidelityFX's runtime.
 REXCVAR_DEFINE_STRING(present_effect, "bilinear", "UI/Presenter",
                       "Guest output effect: bilinear, cas, fsr, fsr2, fsr3")
     .allowed({"bilinear", "cas", "fsr", "fsr2", "fsr3"})
     .lifecycle(rex::cvar::Lifecycle::kRequiresRestart);
+#else
+// The spatial filters are pixel shaders in this tree and need none of
+// FidelityFX's runtime; the temporal upscaler does need it.
+REXCVAR_DEFINE_STRING(present_effect, "bilinear", "UI/Presenter",
+                      "Guest output effect: bilinear, cas, fsr")
+    .allowed({"bilinear", "cas", "fsr"})
+    .lifecycle(rex::cvar::Lifecycle::kRequiresRestart);
+#endif
 
 REXCVAR_DEFINE_DOUBLE(present_cas_additional_sharpness,
                       rex::ui::Presenter::GuestOutputPaintConfig::kCasAdditionalSharpnessDefault,
@@ -285,6 +295,9 @@
   if (lowered == "fsr") {
     return GuestOutputPaintConfig::Effect::kFsr;
   }
+#if defined(REX_HAS_FIDELITYFX_RUNTIME) && REX_HAS_FIDELITYFX_RUNTIME
+  // The temporal upscaler needs FidelityFX's runtime: without it, these two
+  // are not offered and fall back to the spatial filter.
   if (lowered == "fsr2") {
     return GuestOutputPaintConfig::Effect::kFsr2;
   }
@@ -292,6 +305,7 @@
     return GuestOutputPaintConfig::Effect::kFsr3;
   }
 #endif
+#endif
   return GuestOutputPaintConfig::Effect::kBilinear;
 }
 
